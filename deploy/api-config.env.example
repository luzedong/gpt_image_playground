# 将此文件放在服务器上，并以只读方式挂载到容器：
# /etc/gpt-image-playground/api-config.env
#
# 三个 Key 可以分别配置；若只使用一个 Key，可只填写 API_KEY，启动脚本会将其作为兜底。
API_KEY=替换为服务端APIKey

# 可选：服务端出站请求代理。Docker 容器访问宿主机 7890 时通常使用 172.17.0.1。
UPSTREAM_PROXY_URL=

CHAT_API_URL=https://ai-pixel.online/v1
CHAT_API_KEY=

IMAGE_1K_API_URL=https://direct.linkai.pics/v1
IMAGE_1K_API_KEY=

IMAGE_4K_API_URL=https://direct.linkai.pics/v1
IMAGE_4K_API_KEY=

# 两套图像服务商的独立配置。AIPixel 默认用于 1K–2K，AILink 支持 1K–4K。
IMAGE_PIXEL_1K_API_URL=https://ai-pixel.online/v1
IMAGE_PIXEL_1K_API_KEY=
IMAGE_PIXEL_1K_MODEL=gpt-image-2
IMAGE_PIXEL_4K_API_URL=https://ai-pixel.online/v1
IMAGE_PIXEL_4K_API_KEY=
IMAGE_PIXEL_4K_MODEL=gpt-image-2
IMAGE_AILINK_1K_API_URL=https://direct.linkai.pics/v1
IMAGE_AILINK_1K_API_KEY=
IMAGE_AILINK_1K_MODEL=gpt-image-2
IMAGE_AILINK_4K_API_URL=https://direct.linkai.pics/v1
IMAGE_AILINK_4K_API_KEY=
IMAGE_AILINK_4K_MODEL=gpt-image-2
MIMO_API_URL=https://api.xiaomimimo.com/v1
MIMO_API_KEY=
MIMO_ASR_MODEL=mimo-v2.5-asr

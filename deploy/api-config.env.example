# 将此文件放在服务器上，并以只读方式挂载到容器：
# /etc/gpt-image-playground/api-config.env
#
# 三个 Key 可以分别配置；若只使用一个 Key，可只填写 API_KEY，启动脚本会将其作为兜底。
API_KEY=替换为服务端APIKey

CHAT_API_URL=https://ai-pixel.online/v1
CHAT_API_KEY=

IMAGE_1K_API_URL=https://ai-pixel.online/v1
IMAGE_1K_API_KEY=

IMAGE_4K_API_URL=https://direct.linkai.pics/v1
IMAGE_4K_API_KEY=
